#include <stdio.h>
#include<string.h>
int main()
{
    char str[100];
    fgets(str,sizeof(str),stdin);
    int len=strlen(str);
    int vowels=0,dig=0,space=0,alpha=0;
    for(int i=0;i<len;i++){
        if(str[i]=='A'||str[i]=='E'||str[i]=='I'||str[i]=='O'||str[i]=='U'||str[i]=='a'||str[i]=='e'||str[i]=='i'||str[i]=='o'||str[i]=='u'){
            vowels++;
        }
        
        else if(str[i]>='0'&&str[i]<='9'){
            dig++;
        }
        else if(str[i]==' '){
            space++;
        }
        else if(str[i]>='a'&&str[i]<='z'||str[i]>='A'&&str[i]<='Z'){
            alpha++;
        }
    }
    printf("%d ",vowels);
    printf("%d ",dig);
    printf("%d ",space);
    printf("%d ",alpha);

    return 0;
}
