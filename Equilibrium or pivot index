#include <stdio.h>

int main()
{
    int arr[]={1,3,5,2,2};
    int n=5,i;
    int totsum=0;
    int rightsum;
    int found=0;
    for(i=0;i<n;i++){
        totsum=totsum+arr[i];
    }
    int leftsum=0;
    for(i=0;i<n;i++){
         rightsum=totsum-leftsum-arr[i];
         if(rightsum==leftsum){
             printf("Equili ind:%d",i);
             found=1;
             return 0;
         }
         else{
             leftsum=leftsum+arr[i];
         }
    }
    if(found==0)
    printf("No equili ind found");

    return 0;
}
