#include <stdio.h>
int main()
{
    int i,n=5;
    int arr[]={1,2,4,3,5};
    int sorted=0;
    for(i=0;i<n-1;i++){
        if(arr[i]>arr[i+1]){
            sorted=1;
            break;
        }
    }
    if(sorted==1){
        printf("Not sorted");
    }
    else{
        printf("sorted");
    }

    return 0;
}
