#include <stdio.h>

int main()
{
    int i,n1=3,n2=3;
    int arr1[]={1,2,3};
    int arr2[]={4,5,6};
    int arr3[10];
    for(i=0;i<n1;i++){
        arr3[i]=arr1[i];
    }
    for(i=0;i<n2;i++){
        arr3[n1+i]=arr2[i];
    }
    for(i=0;i<n1+n2;i++){
        printf("%d ",arr3[i]);
    }

    return 0;
}
