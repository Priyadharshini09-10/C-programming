#include <stdio.h>

int main()
{
    int i,j,n=6;
    int count;
    int visited[10]={0};
    int arr[]={1,2,2,3,1,1};
    for(i=0;i<n;i++){
        if(visited[i]==1){
            continue;
        }
         count=0;
        for(j=0;j<n;j++){
            if(arr[i]==arr[j]){
                count++;
                visited[j]=1;
            }
        }
        printf("%d->%dtimes\n",arr[i],count);
        
    }
    

    return 0;
}
