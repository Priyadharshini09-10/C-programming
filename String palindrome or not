#include <stdio.h>
#include<string.h>
int main()
{
    char str[]={"level"};
    int len=strlen(str);
    int found=0;
    int left=0;
    int right=len-1;
    while(left<right){
        if(str[left]!=str[right]){
           found=1;
           break;
        }
        left++;
        right--;
    }
    if(found==0)
    printf("Palindrome");
    else
    printf("Not palindrome");
    return 0;
}
