#include <stdio.h>
#include<math.h>
int ArmStrong(int n){
    int sum=0,temp=n,rem,count=0;
    while(temp!=0){
        count++;
        temp=temp/10;
    }
    temp=n;
    while(temp!=0){
        rem=temp%10;
        sum=sum+pow(rem,count);
        temp=temp/10;
    }
    return sum==n;
}
int main()
{
    int n;
    scanf("%d",&n);
    if(ArmStrong(n)){
        printf("Armstrong num");
    }
    else
    printf("Not Arm");
}
