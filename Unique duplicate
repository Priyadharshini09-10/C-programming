#include <stdio.h>
int main()
{
   int i,j,n;
   scanf("%d",&n);
   int arr[n];
   for(i=0;i<n;i++){
       scanf("%d",&arr[i]);
   }
   int flag=0;
   for(i=0;i<n;i++){
       for(j=0;j<i;j++){
           if(arr[i]==arr[j]){
               flag=1;
               break;
           }
       }
       if(flag==1){
           continue;
       }
       for(j=i+1;j<n;j++){
           if(arr[i]==arr[j]){
               printf("%d ",arr[i]);
           }
       }
   }

    return 0;
}
