#include <stdio.h>
int main()
{
    int i,j,n=6;
    int arr[]={1,2,1,4,5,6};
    int visited[10]={0};
    int count;
    int found=0;
    for(i=0;i<n;i++){
        count=0;
        if(visited[i]==1)
        continue;
        for(j=0;j<n;j++){
            if(arr[i]==arr[j]){
                count++;
                visited[j]=1;
            }
        }
        if(count==1){
            printf("1st non-repeating ele:%d",arr[i]);
            found=1;
            return 0;
        }
    }
    if(!found){
        printf("No non-repeating ele");
    }
   

    return 0;
}
