#include <stdio.h>
int main()
{
   int i,n,max,secmax;
   scanf("%d",&n);
   int arr[n];
   for(i=0;i<n;i++){
       scanf("%d",&arr[i]);
   }
   max=arr[0];
   secmax=arr[0];
   for(i=0;i<n;i++){
       if(arr[i]>max){
           secmax=max;
           max=arr[i];
       }
       else if(arr[i]>secmax){
           secmax=arr[i];
       }
   }
   printf("%d",secmax);
    return 0;
}
