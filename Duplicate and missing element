#include <stdio.h>
int main()
{
int arr[]={1,2,3,3,5};
int i,j,n=5;
for(i=0;i<n;i++){
    for(j=i+1;j<n;j++){
        if(arr[i]==arr[j]){
            printf("Dup:%d\n",arr[i]);
            break;
        }
    }
}

int start=arr[0];
int end=arr[n-1];
for(i=start;i<=end;i++){
    int found=0;
    for(j=0;j<n;j++){
        if(i==arr[j]){
            found=1;
            break;
        }
    }
    if(found==0){
        printf("Miss:%d",i);
    }
}
    return 0;
}
