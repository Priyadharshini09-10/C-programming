#include <stdio.h>
int main()
{
   int arr[]={-2,1,-3,4,-1,2,1,-5,4};
   int n=9,i;
   int currsum=arr[0];
   int maxsum=arr[0];
   for(i=1;i<n;i++){
       if(arr[i]>currsum+arr[i]){
           currsum=arr[i];
       }
       else{
           currsum=currsum+arr[i];
       }
       if(currsum>maxsum){
           maxsum=currsum;
       }
       
   }
   printf("%d",maxsum);

    return 0;
}
