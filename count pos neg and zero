#include <stdio.h>
int main()
{
    int n,num;
    int pos=0,neg=0,zero=0;
    scanf("%d",&n);
    for(int i=1;i<=n;i++){
        scanf("%d",&num);
        if(num>0){
            pos++;
        }
        else if(num<0){
            neg++;
        }
        else{
            zero++;
        }
    }
    printf("Pos:%d\nNeg:%d\nZero:%d\n",pos,neg,zero);

    return 0;
}
