#include <stdio.h>
int main()
{
   int n,i,j;
   int found;
   scanf("%d",&n);
   int arr[100];
   for(i=0;i<n;i++){
       scanf("%d",&arr[i]);
   }
   int start=arr[0];
   int end=arr[n-1];
   for(i=start;i<=end;i++){
       found=0;
       for(j=0;j<n;j++){
           if(arr[j]==i){
               found=1;
               break;
           }
       }
       if(found==0){
               printf("%d",i);
           }
   }
    return 0;
}
