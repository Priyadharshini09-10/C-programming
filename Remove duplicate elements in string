#include <stdio.h>
#include<string.h>
int main()
{
    char str[100];
    fgets(str,sizeof(str),stdin);
    int len=strlen(str);
    if(str[len-1]=='\n'){
        str[len-1]='\0';
        len--;
    }
    int i,j,k;
    for(i=0;i<len;i++){
        for(j=i+1;j<len;j++){
            if(str[i]==str[j]){
                for(k=j;k<len-1;k++){
                    str[k]=str[k+1];
                }
                len--;
                j--;
                str[len]='\0';
            }
        }
    }
printf("%s",str);
    return 0;
}
