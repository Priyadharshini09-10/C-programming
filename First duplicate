#include <stdio.h>

int main()
{
    int arr[] = {5,8,3,8,5};
    int n = 5;

    int i,j;

    for(i=0;i<n;i++)
    {
        for(j=i+1;j<n;j++)
        {
            if(arr[i]==arr[j])
            {
                printf("First Duplicate = %d", arr[i]);
                return 0;
            }
        }
    }

    printf("No Duplicate");

    return 0;
}
