#include <stdio.h>
int main()
{
    int i,r,n=5;
    int arr[]={1,2,3,4,5};
    int k=3;
    for(r=0;r<k;r++){
        int temp=arr[n-1];
        for(i=n-1;i>0;i--){
            arr[i]=arr[i-1];
        }
        arr[0]=temp;
    }
    for(i=0;i<n;i++){
        printf("%d ",arr[i]);
    }

    return 0;
}
