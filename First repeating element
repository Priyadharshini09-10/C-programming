#include <stdio.h>
int main()
{
    int i,j,n=6;
    int arr[]={10,5,20,5,3,10};
    int found=0;
    for(i=0;i<n;i++){
        for(j=i+1;j<n;j++){
            if(arr[i]==arr[j]){
                printf("1st repeating ele:%d",arr[i]);
                found=1;
                return 0;
            }
        }
    }
    if(!found){
        printf("No repeating ele");
    }
    return 0;
}
