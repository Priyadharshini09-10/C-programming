#include <stdio.h>
#include<string.h>
int main()
{
    char str1[]={"bca"};
    char str2[]={"abd"};
    int visited[10]={0};
    int len1=strlen(str1);
    int len2=strlen(str2);
    int i,j;
    if(len1!=len2){
        printf("Not anagram");
        return 0;
    }
    for(i=0;i<len1;i++){
        int found=0;
        for(j=0;j<len2;j++){
            if(str1[i]==str2[j]&&visited[j]==0){
                found=1;
                visited[j]=1;
                break;
            }
        }
        if(found==0){
            printf("Not anagram");
            return 0;
        }
    }
    printf("Anagram");

    return 0;
}
